# Copiar para .env.local e preencher (nunca commitar .env.local)

# Ativa/desativa a autenticação Microsoft (MSAL). Enquanto não houver
# App Registration no Entra ID, deixar "false" e usar o carregamento
# manual do ficheiro .db em modo de desenvolvimento.
VITE_AUTH_ENABLED=false

# clientId da App Registration no Microsoft Entra ID (SPA, contas
# pessoais Microsoft). Público por natureza — não é um segredo.
VITE_MSAL_CLIENT_ID=
