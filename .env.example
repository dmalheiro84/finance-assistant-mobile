# Copiar para .env.local e preencher (nunca commitar .env.local)

# Ativa/desativa a autenticação Microsoft (MSAL). Na v1 a app usa
# importação manual do finance.db (sem autenticação), por isso fica
# "false". Reativar assim que houver um App Registration no Entra ID.
VITE_AUTH_ENABLED=false

# clientId da App Registration no Microsoft Entra ID (SPA, contas
# pessoais Microsoft). Público por natureza — não é um segredo.
VITE_MSAL_CLIENT_ID=

# Tenant/authority do MSAL. "consumers" para contas Microsoft pessoais
# (omissão); "common" se o registo vier a aceitar contas pessoais e
# profissionais/escolares.
VITE_MSAL_AUTHORITY=consumers
